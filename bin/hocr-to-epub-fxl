        default="all",
        type=str,
    )

    parser.add_argument(
        '--page-mode', # args.page_mode
        help=f'page mode for all pages. default: {DEFAULT_PAGE_MODE}. values: {PAGE_MODE_VALUES}',
        default=DEFAULT_PAGE_MODE,
        type=str,
    )

    # TODO shorten to --binary-pages etc
    # TODO rename "binary" to "bitonal"
    parser.add_argument(
