    )

    parser.add_argument(
        '--binary-image-threshold-sensitivity', # args.binary_image_threshold_sensitivity
        help=f'Threshold sensitivity (k value) for Sauvola binarization. Higher values produce darker output. Default: {DEFAULT_BINARY_IMAGE_THRESHOLD_SENSITIVITY}',
        default=DEFAULT_BINARY_IMAGE_THRESHOLD_SENSITIVITY,
        type=float,
    )

    parser.add_argument(
        '--binary-image-window-size', # args.binary_image_window_size
