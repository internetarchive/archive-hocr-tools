    parser.add_argument(
        '--grayscale-image-pages', # args.grayscale_image_pages
        help='override page-mode to grayscale for these pages. default: none. example: 1-4',
        default="none",
        type=str,
    )

    parser.add_argument(
        '--color-image-pages', # args.color_image_pages
        help='override page-mode to color for these pages. default: none. example: 1-4',
        default="none",
        type=str,
    )

    parser.add_argument(
        '--append-page',
        dest="append_pages", # args.append_pages
        action='append',
        metavar='PATH[:DST_PATH]',
        help='append page file in HTML or SVG format. the optional DST_PATH is relative to the OEBPS directory',
        type=str,
        default=[],
    )
    parser.add_argument(
        '--add-file',
        dest="add_files", # args.add_files
        action='append',
        metavar='PATH[:DST_PATH]',
        help='add file in any format',
        type=str,
        default=[],
    )

    parser.add_argument(
        '--image-format', # args.image_format
        help=f'image format for all page modes (binary, grayscale, color). default: {DEFAULT_IMAGE_FORMAT}. example: webp',
        # default=None, # DEFAULT_IMAGE_FORMAT
        default=DEFAULT_IMAGE_FORMAT,
        type=str,
    )

    parser.add_argument(
        '--binary-image-format', # args.binary_image_format
        help=f'image format for binary page images. default: image-format',
        default=None,
        type=str,
    )

    parser.add_argument(
        '--grayscale-image-format', # args.grayscale_image_format
        help=f'image format for grayscale page images. default: image-format',
        default=None,
        type=str,
    )

    parser.add_argument(
        '--color-image-format', # args.color_image_format
        help=f'image format for color page images. default: image-format',
        default=None,
        type=str,
    )

    parser.add_argument(
        '--binary-image-save-speed', # args.binary_image_save_speed
        help=f'speed between 0 and 9. default {DEFAULT_BINARY_IMAGE_SAVE_SPEED}. lower is better, but there are exceptions like 7',
        default=DEFAULT_BINARY_IMAGE_SAVE_SPEED,
        type=int,
    )

    parser.add_argument(
        '--grayscale-image-save-speed', # args.grayscale_image_save_speed
        help=f'speed between 0 and 9. default {DEFAULT_GRAYSCALE_IMAGE_SAVE_SPEED}. lower is better, but there are exceptions',
        default=DEFAULT_GRAYSCALE_IMAGE_SAVE_SPEED,
        type=int,
    )

    parser.add_argument(
        '--color-image-save-speed', # args.color_image_save_speed
        help=f'speed between 0 and 9. default {DEFAULT_COLOR_IMAGE_SAVE_SPEED}. lower is better, but there are exceptions',
        default=DEFAULT_COLOR_IMAGE_SAVE_SPEED,
        type=int,
    )

    parser.add_argument(
        # '-f',
        '--text-format', # args.text_format
        help=f'text format for the page images. default: {DEFAULT_TEXT_FORMAT}. values: {", ".join(TEXT_FORMAT_LIST)}',
        default=DEFAULT_TEXT_FORMAT,
        type=str,
    )
    parser.add_argument(
        '--text-html-join-words', # args.text_html_join_words
