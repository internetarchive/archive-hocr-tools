    parser.add_argument(
        '--text-html-join-lines', # args.text_html_join_lines
        help=(
            'do not add linebreaks after lines in html.'
            ' con: the print layout is not preserved in the clipboard text.'
            # https://groups.google.com/a/chromium.org/g/chromium-discuss/c/CJ2Ei2Khb4I
            # text-search across linebreaks should normalize whitespace
            ' pro: this enables text search across lines.'
        ),
        action='store_true',
    )

    parser.add_argument(
        '--text-svg-split-lines', # args.text_svg_split_lines
        help=(
            'split lines of each paragraph to preserve the fixed layout in svg.'
            ' note: this breaks text search across lines in a paragraph.'
        ),
        action='store_true',
    )

    parser.add_argument(
        '--doc-contents-file', # args.doc_contents_file
        help=(
            'document contents file. '
            'example contents.md line: '
            '"- Some Chapter 123" = link to "Some Chapter" on page 123. '
            '"- Some Chapter \\123" = "Some Chapter 123" without link to page'
        ),
        type=str,
    )

    parser.add_argument(
        '--doc-title', # args.doc_title
        help=f'document title',
        default="",
