    parser.add_argument(
        '--jobs', # args.jobs
        help=f'run N jobs in parallel. default: {default_max_workers}. max: {max_max_workers}',
        default=default_max_workers,
        type=int,
    )

    parser.add_argument(
        '--debug', # args.debug
        help='add debug info to the output',
        action='store_true',
    )

    args = parser.parse_args()

    assert 0.01 <= args.scale <= 100
    if args.scale == int(args.scale):
        args.scale = int(args.scale)
    assert 1 <= args.grayscale_image_quality <= 100
    assert 1 <= args.color_image_quality <= 100
    assert 0 <= args.binary_image_save_speed <= 9
    assert 0 <= args.grayscale_image_save_speed <= 9
    assert 0 <= args.color_image_save_speed <= 9

    # args.image_format = args.image_format or DEFAULT_IMAGE_FORMAT
    args.binary_image_format = args.binary_image_format or args.image_format
    args.grayscale_image_format = args.grayscale_image_format or args.image_format
    args.color_image_format = args.color_image_format or args.image_format

    # assert re.match(r"^(\d+)x(\d+)\+(\d+)\+(\d+)$", args.crop_pages)
    # print("PIL.features.codecs", PIL.features.codecs)
    # print("PIL.features.features", PIL.features.features)
    # FIXME this fails for args.image_format == "png"
    # assert PIL.features.check(args.image_format), f"PIL does not support args.image_format {args.image_format!r}"
    if args.text_format == "html":
        args.text_format = "xhtml"
    assert args.text_format in TEXT_FORMAT_LIST
    assert 1 <= args.jobs <= max_max_workers, f"jobs must be between 1 and {max_max_workers}"
    for src_path in args.infiles:
        with open(src_path, "rb") as f: # try to open the file
            pass
    for src_path in (args.append_pages + args.add_files):
        src_path, dst_path = parse_src_dst_path(src_path)
        with open(src_path, "rb") as f: # try to open the file
            pass
    if args.canonical_url_base:
        if not args.canonical_url_base.endswith("/"):
            args.canonical_url_base += "/"

    args.text_html_absolute_word_positions = not args.text_html_relative_word_positions
    # args.text_html_relative_word_positions = not args.text_html_absolute_word_positions

    if not args.text_html_relative_word_positions:
        args.text_html_relative_word_positions_dynamic_font_width = False
        args.text_html_relative_word_positions_static_font_width = False
    else:
        args.text_html_relative_word_positions_static_font_width = not args.text_html_relative_word_positions_dynamic_font_width

    args.text_html_bundle_font = False

    if args.doc_isbn:
        pass
    elif args.doc_identifier:
        pass
    else:
        raise ValueError("document identifier is required. hint: set doc-isbn or doc-identifier")

    process_files_hocr2epubfxl(args)
