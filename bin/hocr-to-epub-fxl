from tqdm import tqdm as original_tqdm

class tqdm(original_tqdm):
    """
    use CPU time instead of wall-clock time
    https://github.com/tqdm/tqdm/issues/1748
    """
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        
        # Override the time function to CPU time
        self._time = time.process_time
        
        # Reset start time to CPU clock
        self.start_t = self._time()
        self.last_print_t = self.start_t

    def reset(self, total=None):
        super().reset(total=total)
        self.start_t = self._time()
        self.last_print_t = self.start_t


hocrfile_extensions = ("hocr", "html", "xhtml")

# no. binary page mode is too lossy.
# characters can look aliased/jagged
# After downsampling from 600 dpi to 150 dpi and converting the image to bitonal,
# glyph contours become aliased,
# producing one-pixel stair-step artifacts along edges that were originally straight.
# we cannot use binary/bitonal group4 images in most browsers anyway
# and we cannot use group4-polyfill over the file protocol
# DEFAULT_PAGE_MODE = "binary"
DEFAULT_PAGE_MODE = "grayscale"
PAGE_MODE_VALUES = (
    "binary",
    "grayscale",
    "color",
)

# use imagemagick to compare avif qualities around 20%
r'''
src=001.tiff;
for (( q=10; q<=30; q++ )); do
    dst="$src".magick.s50.q$(printf %03d "$q").avif;
    [ -e "$dst" ] && continue;
    magick "$src" -scale 50% -quality ${q}% \
        -define heic:lossless=true \
        -define heic:chroma-subsample=4:4:4 \
        -define heic:speed=0 \
        "$dst";
done
'''

DEFAULT_IMAGE_FORMAT = "avif"
# DEFAULT_BINARY_IMAGE_FORMAT = "avif"
