DEFAULT_GRAYSCALE_IMAGE_SAVE_SPEED = 6
DEFAULT_COLOR_IMAGE_SAVE_SPEED = 6

DEFAULT_BINARY_IMAGE_ALGO = "sauvola"

# low values produce blurry characters
# high values produce sharp characters
# this is visible in very small characters
# for example a "registered trademark symbol" in superscript
DEFAULT_BINARY_IMAGE_THRESHOLD_SENSITIVITY = 0.8

# no. throw later
